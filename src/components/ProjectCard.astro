---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

function hueFromString(str: string) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) hash = str.charCodeAt(i) + ((hash << 5) - hash);
  return Math.abs(hash) % 360;
}

const hue = hueFromString(project.title);
const gradient = `linear-gradient(135deg, hsl(${hue} 55% 14%), hsl(${(hue + 40) % 360} 55% 9%))`;
---
<div class="project reveal" style={`--i:${index % 3}`} data-tag={project.tag} data-index={index}>
  <div class="project-media">
    <div class="project-placeholder" style={`background:${gradient}`}>
      {project.media.type === 'video' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M15 10l4.55-2.28A1 1 0 0121 8.62v6.76a1 1 0 01-1.45.9L15 14M4 6h9a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="M21 15l-5-5L5 21" />
        </svg>
      )}
      <b>{project.title}</b>
      <small>Visuel à ajouter dans /public/img</small>
    </div>
    {project.media.type === 'video' ? (
      <video class="project-media-el" src={project.media.src} autoplay loop muted playsinline></video>
    ) : (
      <img class="project-media-el" src={project.media.src} alt={project.title} loading="lazy" />
    )}
    <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
    <span class="project-tag">{project.tag}</span>
  </div>
  <div class="project-body">
    <h3>{project.title}</h3>
    <p>{project.desc}</p>
  </div>
</div>
